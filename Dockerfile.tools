# Shared base image: golang official image + the release toolchain
# (cosign / syft / goreleaser / ko / git-chglog / docker-cli / buildx / pack
# / goimports / gcloud). Both the osxcross builder and the zig image build on
# top of this, so the tools are defined and versioned in exactly ONE place.
#
# Multi-arch: TARGETARCH (amd64|arm64) selects the per-arch binary + checksum.
# Naming is NOT uniform across tools: cosign/syft/git-chglog/buildx use
# "amd64"/"arm64", goreleaser/ko use "x86_64"/"arm64", docker-cli uses
# "x86_64"/"aarch64", pack uses ""/"-arm64" suffix.
#
# GO_VERSION is WITHOUT the "go" prefix (matches the official golang image
# tag, e.g. golang:1.26.6-trixie).
ARG GO_VERSION=1.27.4
ARG OS_CODENAME=trixie

FROM golang:${GO_VERSION}-${OS_CODENAME}

LABEL maintainer="Goren G<gythialy.koo+github@gmail.com>"
LABEL org.opencontainers.image.source=https://github.com/gythialy/golang-cross

# ============================================================
# Tool versions - managed by scripts/check-update.sh
# ============================================================
ARG TARGETARCH
ARG COSIGN_VERSION=v3.1.4
ARG COSIGN_SHA=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
ARG COSIGN_SHA_ARM64=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2
ARG SYFT_VERSION=v1.57.1
ARG SYFT_SHA=bf52519eb57f675d47c07d43213cb6dff6449f3d6d1147ff6701ed91f44eef0c
ARG SYFT_SHA_ARM64=aa3d3e07344f590bcce8d31043b752daa76c8a56c2aa34ceeee63c6168152582
ARG GORELEASER_VERSION=v2.20.1
ARG GORELEASER_SHA=79e0589ca9efd70e8db85158a21334cbb57811d4034b39b61d55789f361341a5
ARG GORELEASER_SHA_ARM64=81dc6c218288358e8c0b021ee1fceb6a6a3ec4f29b11bf830cab985507af492d
ARG KO_VERSION=v0.19.1
ARG KO_SHA=635ac6ea3fd376c935fee597fbb29ab2c2449f49ef1655085fe3aa9c25fed7a5
ARG KO_SHA_ARM64=4099b2d1170d3b8a70e049237462efc2dd14d5fa30e9d2e5e108fb4f778cdd3f
ARG GIT_CHGLOG_VERSION=v0.15.4
ARG GIT_CHGLOG_SHA=03cbeedbd1317289295e75016fa0acd26baeb2fc7810ed287361dd9bd8bc33a8
ARG GIT_CHGLOG_SHA_ARM64=75d6fcfe1e2f7335a37048e01db53b87035a11ab78a8c3fc2ba65a6e5794f71f
ARG DOCKER_CLI_VERSION=29.5.1
ARG DOCKER_CLI_SHA=dfa6e37ffe24e71a637f737ec911e24dcd7a106e01973636cb33a201728a9bd6
ARG DOCKER_CLI_SHA_ARM64=2ea0c005ebb1b0f58bc70d1e1fea54a6dc56ab98d246f60ed012f2c92ae1c9c8
ARG BUILDX_VERSION=v0.38.2
ARG BUILDX_SHA=7992ec09413b80ff57ba4e081f56fc833d7bac1d5e71143c6c809e7e6065f6d6
ARG BUILDX_SHA_ARM64=46c0f334772de3cb0b341cc415caf7339fb5cfc8b8438ebcb5a10e7f23800d36
ARG PACK_VERSION=v0.40.10
ARG PACK_SHA=687c3616e21824a449b56d4f989613ca68c921c6cce670b4de4459b025233806
ARG PACK_SHA_ARM64=9a294abb0576fd95e19a009b3f9d5f5aa9fecdc2d7da7fa05e7e1e94f5085d77
ARG GOIMPORTS_VERSION=v0.52.0

# Download all tools in parallel (network-bound), verify checksums, then install.
# Parallel downloads cut the wall-clock time vs the old serial wget loop.
# wait with explicit pids so a failed background download fails the build.
RUN set -eux; \
    case "$TARGETARCH" in \
      arm64) \
        TOOL_ARCH=arm64; X64_ARCH=arm64; DOCKER_ARCH=aarch64; PACK_SUFFIX=-arm64; \
        SHA_COSIGN="$COSIGN_SHA_ARM64"; SHA_SYFT="$SYFT_SHA_ARM64"; SHA_GORELEASER="$GORELEASER_SHA_ARM64"; \
        SHA_KO="$KO_SHA_ARM64"; SHA_GIT_CHGLOG="$GIT_CHGLOG_SHA_ARM64"; SHA_DOCKER="$DOCKER_CLI_SHA_ARM64"; \
        SHA_BUILDX="$BUILDX_SHA_ARM64"; SHA_PACK="$PACK_SHA_ARM64"; \
        ;; \
      *) \
        TOOL_ARCH=amd64; X64_ARCH=x86_64; DOCKER_ARCH=x86_64; PACK_SUFFIX=; \
        SHA_COSIGN="$COSIGN_SHA"; SHA_SYFT="$SYFT_SHA"; SHA_GORELEASER="$GORELEASER_SHA"; \
        SHA_KO="$KO_SHA"; SHA_GIT_CHGLOG="$GIT_CHGLOG_SHA"; SHA_DOCKER="$DOCKER_CLI_SHA"; \
        SHA_BUILDX="$BUILDX_SHA"; SHA_PACK="$PACK_SHA"; \
        ;; \
    esac; \
    mkdir -p /tmp/dl && cd /tmp/dl; \
    wget -qO cosign https://github.com/sigstore/cosign/releases/download/${COSIGN_VERSION}/cosign-linux-${TOOL_ARCH} & p1=$!; \
    wget -qO syft.tar.gz https://github.com/anchore/syft/releases/download/${SYFT_VERSION}/syft_${SYFT_VERSION#v}_linux_${TOOL_ARCH}.tar.gz & p2=$!; \
    wget -qO goreleaser.tar.gz https://github.com/goreleaser/goreleaser/releases/download/${GORELEASER_VERSION}/goreleaser_Linux_${X64_ARCH}.tar.gz & p3=$!; \
    wget -qO ko.tar.gz https://github.com/ko-build/ko/releases/download/${KO_VERSION}/ko_${KO_VERSION#v}_Linux_${X64_ARCH}.tar.gz & p4=$!; \
    wget -qO git-chglog.tar.gz https://github.com/git-chglog/git-chglog/releases/download/${GIT_CHGLOG_VERSION}/git-chglog_${GIT_CHGLOG_VERSION#v}_linux_${TOOL_ARCH}.tar.gz & p5=$!; \
    curl -fsSLO https://download.docker.com/linux/static/stable/${DOCKER_ARCH}/docker-${DOCKER_CLI_VERSION}.tgz & p6=$!; \
    wget -qO buildx https://github.com/docker/buildx/releases/download/${BUILDX_VERSION}/buildx-${BUILDX_VERSION}.linux-${TOOL_ARCH} & p7=$!; \
    wget -qO pack.tgz https://github.com/buildpacks/pack/releases/download/${PACK_VERSION}/pack-${PACK_VERSION}-linux${PACK_SUFFIX}.tgz & p8=$!; \
    wait $p1 $p2 $p3 $p4 $p5 $p6 $p7 $p8; \
    echo "${SHA_COSIGN}  cosign" | sha256sum -c -; \
    echo "${SHA_SYFT}  syft.tar.gz" | sha256sum -c -; \
    echo "${SHA_GORELEASER}  goreleaser.tar.gz" | sha256sum -c -; \
    echo "${SHA_KO}  ko.tar.gz" | sha256sum -c -; \
    echo "${SHA_GIT_CHGLOG}  git-chglog.tar.gz" | sha256sum -c -; \
    echo "${SHA_DOCKER}  docker-${DOCKER_CLI_VERSION}.tgz" | sha256sum -c -; \
    echo "${SHA_BUILDX}  buildx" | sha256sum -c -; \
    echo "${SHA_PACK}  pack.tgz" | sha256sum -c -; \
    mv cosign /usr/local/bin/cosign && chmod +x /usr/local/bin/cosign; \
    tar -xzf syft.tar.gz -C /usr/bin/ syft; \
    tar -xzf goreleaser.tar.gz -C /usr/bin/ goreleaser; \
    tar -xzf ko.tar.gz -C /usr/bin/ ko; \
    tar -xzf git-chglog.tar.gz -C /usr/bin/ git-chglog; \
    tar xzf docker-${DOCKER_CLI_VERSION}.tgz --strip 1 -C /usr/local/bin docker/docker; \
    chmod a+x buildx && mkdir -p ~/.docker/cli-plugins && mv buildx ~/.docker/cli-plugins/docker-buildx; \
    tar xzf pack.tgz -C /usr/local/bin pack --no-same-owner; \
    rm -rf /tmp/dl; \
    cd /; \
    cosign version && syft version && goreleaser -v && ko version && git-chglog -v && docker -v && pack version

# install gcloud sdk (single apt cycle, https source, clean lists to slim the image)
RUN apt-get update -y && apt-get install -y -q --no-install-recommends apt-transport-https ca-certificates gnupg \
	&& curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
	&& echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" | tee -a /etc/apt/sources.list.d/google-cloud-sdk.list \
	&& apt-get update -y && apt-get install -y -q google-cloud-cli \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/*

# install goimports (pinned version so the layer cache hits across builds; drop the go build cache afterwards).
# GOTOOLCHAIN=auto lets older Go (e.g. 1.24) build a goimports that requires a
# newer Go by switching to the matching toolchain, then drop that toolchain
# from the image (it is only needed to compile goimports, not to run it).
RUN GOTOOLCHAIN=auto go install golang.org/x/tools/cmd/goimports@${GOIMPORTS_VERSION} \
	&& go clean -cache \
	&& rm -rf "$(go env GOMODCACHE)/golang.org/toolchain"*
